---
import '@/src/styles/main.scss';
import '@/src/styles/pets/calculator/calculator.scss';
import '@/src/styles/calculators.scss';
import Navbar from '@/src/components/navbar.astro';
import Blinkies from '@/src/components/blinkies.astro';
import Head from '@/src/components/head.astro';
import EmbedMessage from '@/src/components/embedMessage.astro';
import Message from '@/src/components/message.astro';
---
<!doctype html>
<html>
  <Head title="Pets - Calculator" description="A calculator OwO Bot's pet stats" />
  <body>
    <div class="center-pillar"> 
      <Navbar/>
      <div class="page-wrapper">
        <div class="page-wrapper__inner">
          <Message avatar="/assets/images/owo_images/avatars/owo_avatar.png" name="OwO" bot={false}>
            <div style="display: flex; gap: 1rem;">
              <div class="embed">
                <h3 class="calculator-header">
                  <img src="/assets/images/owo_images/huntbot/robot.png" class="emote" />
                  Pet Calculator
                </h3>
                <div class="level-wrapper">
                  <div id="level-wrapper__number-wrapper" class="level-wrapper__number-wrapper">
                    <code>&nbsp;Lvl.&nbsp;</code>
                    <input
                      class="input-lvl"
                      type="number"
                      min="1"
                      value="20"
                      tabindex="1"
                    />
                  </div>
                  <input id="level-wrapper__slider" type="range" min="1" max="120" value="20" />
                </div>
                <div class="pet-input-grid">
                  <div class="pet-input-grid__cell">
                    <img src="/assets/images/owo_images/battleEmojis/hp.png" class="pet-input-grid__stat-emote" />
                    <input
                      required
                      class="pet-input-grid__input"
                      type="number"
                      min="0"
                      max="99"
                      value="15"
                      tabindex="2"
                    /><code class="pet-input-grid__output"></code>
                  </div>
                  <div class="pet-input-grid__cell">
                    <img src="/assets/images/owo_images/battleEmojis/wp.png" class="pet-input-grid__stat-emote" />
                    <input
                      required
                      class="pet-input-grid__input"
                      type="number"
                      min="0"
                      max="99"
                      value="1"
                      tabindex="5"
                    /><code class="pet-input-grid__output"></code>
                  </div>
                  <div class="pet-input-grid__cell">
                    <img src="/assets/images/owo_images/battleEmojis/str.png" class="pet-input-grid__stat-emote" />
                    <input
                      required
                      class="pet-input-grid__input"
                      type="number"
                      min="0"
                      max="99"
                      value="1"
                      tabindex="3"
                    /><code class="pet-input-grid__output"></code>
                  </div>
                  <div class="pet-input-grid__cell">
                    <img src="/assets/images/owo_images/battleEmojis/mag.png" class="pet-input-grid__stat-emote" />
                    <input
                      required
                      class="pet-input-grid__input"
                      type="number"
                      min="0"
                      max="99"
                      value="1"
                      tabindex="6"
                    /><code class="pet-input-grid__output"></code>
                  </div>
                  <div class="pet-input-grid__cell">
                    <img src="/assets/images/owo_images/battleEmojis/pr.png" class="pet-input-grid__stat-emote" />
                    <input
                      required
                      class="pet-input-grid__input"
                      type="number"
                      min="0"
                      max="99"
                      value="1"
                      tabindex="4"
                    /><code class="pet-input-grid__output"> %</code>
                  </div>
                  <div class="pet-input-grid__cell">
                    <img src="/assets/images/owo_images/battleEmojis/mr.png" class="pet-input-grid__stat-emote" />
                    <input
                      required
                      class="pet-input-grid__input"
                      type="number"
                      min="0"
                      max="99"
                      value="1"
                      tabindex="7"
                    /><code class="pet-input-grid__output"> %</code>
                  </div>
                </div>
                <span id="stat-span" class="stat-span">20 stats</span>
              </div>
              <div class="embed effect-container" id="effect-container"></div>
            </div>
          </Message>
          <EmbedMessage avatar="/assets/images/owo_images/avatars/neonutil.png" name="NeonUtil" bot={true}>
            <div class="pet-output-grid">
              <div class="pet-output-grid__cell">
                <img
                  src="/assets/images/owo_images/battleEmojis/prhp.png"
                  class="pet-output-grid__stat-emote"
                />
                <code class="pet-output-grid__stat-title">eHP</code>
                <code class="pet-output-grid__output"></code>
              </div>
              <div class="pet-output-grid__cell">
                <img
                  src="/assets/images/owo_images/battleEmojis/mrhp.png"
                  class="pet-output-grid__stat-emote"
                />
                <code class="pet-output-grid__stat-title">eHP</code>
                <code class="pet-output-grid__output"></code>
              </div>
              <div class="pet-output-grid__cell">
                <img src="/assets/images/owo_images/battleEmojis/ipr.png" class="pet-output-grid__stat-emote" />
                <code class="pet-output-grid__stat-title">iPR</code>
                <code class="pet-output-grid__output"></code>
              </div>
              <div class="pet-output-grid__cell">
                <img src="/assets/images/owo_images/battleEmojis/imr.png" class="pet-output-grid__stat-emote" />
                <code class="pet-output-grid__stat-title">iMR</code>
                <code class="pet-output-grid__output"></code>
              </div>
            </div>
            <button tabindex="8" class="mode-switch-button" id="mode-switch-button">Mode: Matching Pets</button>
            <div id="mode-container" class="mode-container"></div>
          </EmbedMessage>
        </div>
      </div>
      <Blinkies/>
    </div>
    <script>
      import '@/src/scripts/pets/calculator/calculator.js'
      import '@/src/scripts/timestamp';
    </script>
  </body>
</html>
