---
import '../../styles/main.css';
import '../../styles/huntbot/calculator.css';
import Navbar from '../../components/navbar.astro';
import Blinkies from '../../components/blinkies.astro';
import Head from '../../components/head.astro';
import EmbedMessage from '../../components/embedMessage.astro';
---
<html>
  <Head title="Huntbot - Calculator" description="A calculator for OwO Bot's huntbot" />
  <body>
    <div class="center-pillar">
      <Navbar/>
      <div class="page-wrapper">
        <EmbedMessage avatar="/src/assets/images/owo_images/avatars/owo_avatar.png" name="OwO" bot={true}>
          <h3>HuntBot</h3>
          <div class="subtle-gray-hover intro">
            <div style="flex: auto">
              <code class="discord-code"
                >BEEP. BOOP. I AM HUNTBOT. I WILL HUNT FOR YOU MASTER.</code
              ><br />
              Use the command
              <code class="discord-code">owo autohunt &#123;cowoncy&#125;</code> to get started.<br />
              You can use
              <code class="discord-code">owo upgrade &#123;trait&#125; &#123;count&#125;</code> to upgrade the traits
              below.<br />
              To obtain more essence, use
              <code class="discord-code">owo sacrifice &#123;animal&#125; &#123;count&#125;</code>.
            </div>
            <img class="discord-pet-display" src="/src/assets/images/owo_images/huntbot/robot.png" />
          </div>
          <div class="gridContainer"></div>
          <div id="table-box" class="subtle-gray-hover"></div>
        </EmbedMessage>
        <EmbedMessage avatar="/src/assets/images/owo_images/avatars/neonutil.png" name="NeonUtil" bot={true}>
          <div class="tier-table" draggable="false"></div>
          <div class="gapped-box biggest">
            <div class="gapped-box column" style="width: 7rem">
              <label class="gray-hover prevent-select gapped-box center-box" id="patreonCheck">
                <input type="checkbox" />
                <strong>Patreon</strong>
              </label>
              <div id="sacToggles" class="gapped-box flexing-children">
                <button class="gray-hover center-box bigger">
                  <img src="/src/assets/images/owo_images/cowoncy.png" class="smol" draggable="false" />
                </button>
                <button class="gray-hover center-box bigger">
                  <img src="/src/assets/images/owo_images/essence.gif" class="smol" draggable="false" />
                </button>
              </div>
            </div>
            <div class="gapped-box">
              <div style="min-width: 12rem">
                <h4>Pet Worth:</h4>
                <ul>
                  <li style="margin-bottom: 0.5rem">
                    <span class="petworth"> </span>
                    <ul><li class="petworth"></li></ul>
                  </li>
                  <li class="petworth"></li>
                </ul>
              </div>
              <div>
                <h4>HB Pet Worth:</h4>
                <ul>
                  <li style="margin-bottom: 0.5rem">
                    <span class="hbworth"></span>
                    <ul><li class="hbworth"></li></ul>
                  </li>
                  <li class="hbworth"></li>
                </ul>
              </div>
            </div>
          </div>
        </EmbedMessage>
        <EmbedMessage avatar="/src/assets/images/owo_images/avatars/reactionbot.png" name="reaction bot" bot={true}>
          <div class="gapped-box flexing-children button-container" id="simming-buttons">
            <button class="gray-hover">(f)irst</button>
            <button class="gray-hover">(p)rev</button>
            <button class="gray-hover">(n)ext</button>
            <button class="gray-hover">(l)ast</button>
            <button class="gray-hover">(r)eset</button>
          </div>
          <div id="huntbotIdx">0/0</div>
          <div class="consistent-images simming-container">
            <div class="zoo-container">
              <div style="display: flex">
                <img src="/src/assets/images/owo_images/huntbot/robot.png" />&nbsp;|&nbsp;<code
                  class="discord-code huntbotLine"
                  >BEEP BOOP</code
                >
              </div>
              <div style="display: flex">
                <img src="/src/assets/images/misc_images/blank.png" />&nbsp;|&nbsp;<code
                  class="discord-code huntbotLine"
                  >BOOP BEEP BEEP</code
                >
              </div>
              <div id="huntbotContainer" class="tier-container"></div>
              <div class="value-wrapper">
                <details class="zp-container">
                  <summary class="prevent-select">
                    <div class="details-row">
                      <div><img src="/src/assets/images/misc_images/chevron.png" /></div>
                      <div>Value</div>
                    </div>
                  </summary>
                  <div>
                    <div class="details-row">
                      <div><img src="/src/assets/images/owo_images/cowoncy.png" /></div>
                      <div>Cowoncy:</div>
                      <code id="cowoncyHbValue" class="discord-code">0</code>
                    </div>
                    <div class="details-row">
                      <div><img src="/src/assets/images/owo_images/essence.gif" /></div>
                      <div>Essence:</div>
                      <code id="essenceHbValue" class="discord-code">0</code>
                    </div>
                  </div>
                </details>
                <details class="zp-container">
                  <summary class="prevent-select">
                    <div class="details-row">
                      <div><img src="/src/assets/images/misc_images/chevron.png" /></div>
                      <div>Expected Pets</div>
                      <div>Actual Pets</div>
                    </div>
                  </summary>
                  <div id="hb-luck-container"></div>
                </details>
              </div>
            </div>
            <div class="zoo-container">
              <div style="display: flex">
                <code class="discord-code">🌿 🌱 🌳 your zoo! 🌳 🌿 🌱</code>
              </div>
              <div id="zooContainer" class="tier-container"></div>
              <div class="zp-container">Zoo Points: <span id="zpSpan">0</span></div>
              <div class="zp-container" id="tierCountContainer"></div>
              <div class="value-wrapper">
                <details class="zp-container">
                  <summary class="prevent-select">
                    <div class="details-row">
                      <div><img src="/src/assets/images/misc_images/chevron.png" /></div>
                      <div>Value</div>
                    </div>
                  </summary>
                  <div>
                    <div class="details-row">
                      <div><img src="/src/assets/images/owo_images/cowoncy.png" /></div>
                      <div>Cowoncy:</div>
                      <code id="cowoncyZooValue" class="discord-code">0</code>
                    </div>
                    <div class="details-row">
                      <div><img src="/src/assets/images/owo_images/essence.gif" /></div>
                      <div>Essence:</div>
                      <code id="essenceZooValue" class="discord-code">0</code>
                    </div>
                  </div>
                </details>
                <details class="zp-container">
                  <summary class="prevent-select">
                    <div class="details-row">
                      <div><img src="/src/assets/images/misc_images/chevron.png" /></div>
                      <div>Expected Pets</div>
                      <div>Actual Pets</div>
                    </div>
                  </summary>
                  <div id="zoo-luck-container"></div>
                </details>
              </div>
            </div>
          </div>
        </EmbedMessage>
      </div>
      <Blinkies/>
    </div>
    <script>
      import '../../scripts/huntbot/calculator';
    </script>
  </body>
</html>
