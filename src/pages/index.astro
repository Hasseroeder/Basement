---
import '@/src/styles/main.css';
import '@/src/styles/index/index.css';
import Navbar from '@/src/components/navbar.astro';
import Blinkies from '@/src/components/blinkies.astro';
import Head from '@/src/components/head.astro';

import Intro from '@/src/content/index/intro.mdx';

import cat1 from '@/src/asciiArt/cat1.txt?raw';
import cat2 from '@/src/asciiArt/cat2.txt?raw';
---
<html>
  <Head title="Introduction" description="A guide for OwO Bot's battle-related mechanics" />
  <body>
    <div class="center-pillar">
      <Navbar />
      <section ><Intro /></section>
      <section style="display: flex; justify-content: center">
        <div class="section-wrapper">
          <section class="table-section">
            <pre class="art-display">{cat1}</pre>
            <div>
              <h3>## Basement</h3>
              <div class="table-wrapper">
                <div>
                  <h4 class="subscript grayed-text">Our Links</h4>
                  <table>
                    <tr>
                      <td><a href="https://owo.bwep.net/">this Website</a></td>
                    </tr>
                    <tr>
                      <td><a href="https://github.com/Hasseroeder/Basement/">Github</a></td>
                    </tr>
                    <tr>
                      <td><a href="https://discord.gg/wA82GZ2rnR">Discord Server</a></td>
                    </tr>
                  </table>
                </div>
                <div>
                  <h4 class="subscript grayed-text">Our Team</h4>
                  <table>
                    <tr>
                      <td>Heather</td>
                      <td style="position: relative">
                        <code class="discord-code on-top">@hsse</code>
                        <img src="/src/assets/images/misc_images/gray_discord_logo.svg" class="platform-logo" />
                      </td>
                      <td style="position: relative">
                        <a href="https://github.com/Hasseroeder" class="on-top">Hasseroeder</a>
                        <img src="/src/assets/images/misc_images/gray_github_logo.svg" class="platform-logo" />
                      </td>
                    </tr>
                    <tr>
                      <td>April</td>
                      <td>
                        <code class="discord-code on-top">@aprilflwrs</code>
                      </td>
                      <td>
                        <a href="https://github.com/coopw1" class="on-top">coopw1</a>
                      </td>
                    </tr>
                    <tr>
                      <td>Smeagol</td>
                      <td>
                        <code class="discord-code on-top">@iamsmeagol</code>
                      </td>
                      <td>
                        <a href="https://github.com/IamSmeagol" class="on-top">IamSmeagol</a>
                      </td>
                    </tr>
                  </table>
                </div>
              </div>
            </div>
          </section>
          <section class="table-section">
            <pre class="art-display">{cat2}</pre>
            <div>
              <h3>## Friends & Useful Stuff</h3>
              <div class="table-wrapper">
                <div>
                  <h4 class="subscript grayed-text">Relevant Bots</h4>
                  <table>
                    <tr>
                      <td>OwO</td>
                      <td>
                        <a
                          href="https://discordapp.com/oauth2/authorize?client_id=408785106942164992"
                          >Invite Bot</a
                        >
                      </td>
                      <td><a href="https://owobot.com/">Website</a></td>
                      <td><a href="https://discord.gg/wA82GZ2rnR">Support Server</a></td>
                    </tr>
                    <tr>
                      <td>NeonUtil</td>
                      <td>
                        <a href="https://discord.com/oauth2/authorize?client_id=851436490415931422"
                          >Invite Bot</a
                        >
                      </td>
                      <td><a href="https://neonutil.com/">Website</a></td>
                      <td><a href="https://discord.gg/NeonUtil">Support Server</a></td>
                    </tr>
                    <tr>
                      <td>ReactionBot</td>
                      <td>
                        <a
                          href="https://discord.com/oauth2/authorize?client_id=519287796549156864&permissions=478272&scope=bot+applications.commands"
                          >Invite Bot</a
                        >
                      </td>
                      <td>—</td>
                      <td><a href="https://discord.gg/KwfCk7r">Support Server</a></td>
                    </tr>
                  </table>
                </div>
                <div>
                  <h4 class="subscript grayed-text">Other Guides</h4>
                  <table>
                    <tr>
                      <td>
                        <a href="https://owobot.fandom.com/wiki/OwO_Bot_Wiki">OwO Bot Wiki</a>
                      </td>
                    </tr>
                    <tr>
                      <td>
                        <a
                          href="https://discord.gg/gg-obbe-owo-bot-battle-enthusiasts-748179924749123662"
                          >Kane's OBBE Guide</a
                        >
                      </td>
                    </tr>
                  </table>
                </div>
              </div>
            </div>
          </section>
        </div>
      </section>
      <Blinkies />
    </div>
  </body>
</html>
