---
import '@/src/styles/main.css';
import '@/src/styles/index/index.scss';
import Navbar from '@/src/components/navbar.astro';
import Blinkies from '@/src/components/blinkies.astro';
import Head from '@/src/components/head.astro';

import Intro from '@/src/content/index/intro.mdx';

import Cat1 from '@/src/assets/asciiArt/cat1.txt?raw';
import Cat2 from '@/src/assets/asciiArt/cat2.txt?raw';
---
<html>
  <Head title="Introduction" description="A guide for OwO Bot's battle-related mechanics" />
  <body>
    <div class="center-pillar">
      <Navbar />
      <section ><Intro /></section>
      <div class="table-sections-wrapper">
        <section class="table-section">
          <pre class="art-display">{Cat1}</pre>
          <div class="table-section__inner-wrapper">
            <h3 class="table-section__section-header">## Basement</h3>
            <div class="table-section__tables-wrapper">
              <div class="table-section__table-wrapper">
                <h4 class="table-section__table-header">Our Links</h4>
                <table class="link-table">
                  <tr class="link-table__row">
                    <td class="link-table__cell"><a href="https://owo.bwep.net/">this Website</a></td>
                  </tr>
                  <tr class="link-table__row">
                    <td class="link-table__cell"><a href="https://github.com/Hasseroeder/Basement/">Github</a></td>
                  </tr>
                  <tr class="link-table__row">
                    <td class="link-table__cell"><a href="https://discord.gg/wA82GZ2rnR">Discord Server</a></td>
                  </tr>
                </table>
              </div>
              <div class="table-section__table-wrapper">
                <h4 class="table-section__table-header">Our Team</h4>
                <table class="link-table">
                  <tr class="link-table__row">
                    <td class="link-table__cell">Heather</td>
                    <td class="link-table__cell">
                      <code class="discord-code">@hsse</code>
                      <img src="/src/assets/images/misc_images/gray_discord_logo.svg" class="link-table__platform-logo" />
                    </td>
                    <td class="link-table__cell">
                      <a href="https://github.com/Hasseroeder">Hasseroeder</a>
                      <img src="/src/assets/images/misc_images/gray_github_logo.svg" class="link-table__platform-logo" />
                    </td>
                  </tr>
                  <tr class="link-table__row">
                    <td class="link-table__cell">April</td>
                    <td class="link-table__cell">
                      <code class="discord-code">@aprilflwrs</code>
                    </td>
                    <td class="link-table__cell">
                      <a href="https://github.com/coopw1">coopw1</a>
                    </td>
                  </tr>
                  <tr class="link-table__row">
                    <td class="link-table__cell">Smeagol</td>
                    <td class="link-table__cell">
                      <code class="discord-code">@iamsmeagol</code>
                    </td>
                    <td class="link-table__cell">
                      <a href="https://github.com/IamSmeagol">IamSmeagol</a>
                    </td>
                  </tr>
                </table>
              </div>
            </div>
          </div>
        </section>
        <section class="table-section">
          <pre class="art-display">{Cat2}</pre>
          <div class="table-section__inner-wrapper">
            <h3 class="table-section__section-header">## Friends & Useful Stuff</h3>
            <div class="table-section__tables-wrapper">
              <div class="table-section__table-wrapper">
                <h4 class="table-section__table-header">Relevant Bots</h4>
                <table class="link-table">
                  <tr class="link-table__row">
                    <td class="link-table__cell">OwO</td>
                    <td class="link-table__cell">
                      <a
                        href="https://discordapp.com/oauth2/authorize?client_id=408785106942164992"
                        >Invite Bot</a
                      >
                    </td>
                    <td class="link-table__cell"><a href="https://owobot.com/">Website</a></td>
                    <td class="link-table__cell"><a href="https://discord.gg/wA82GZ2rnR">Support Server</a></td>
                  </tr>
                  <tr class="link-table__row">
                    <td class="link-table__cell">NeonUtil</td>
                    <td class="link-table__cell">
                      <a href="https://discord.com/oauth2/authorize?client_id=851436490415931422"
                        >Invite Bot</a
                      >
                    </td>
                    <td class="link-table__cell"><a href="https://neonutil.com/">Website</a></td>
                    <td class="link-table__cell"><a href="https://discord.gg/NeonUtil">Support Server</a></td>
                  </tr>
                  <tr class="link-table__row">
                    <td class="link-table__cell">ReactionBot</td>
                    <td class="link-table__cell">
                      <a
                        href="https://discord.com/oauth2/authorize?client_id=519287796549156864&permissions=478272&scope=bot+applications.commands"
                        >Invite Bot</a
                      >
                    </td>
                    <td class="link-table__cell">—</td>
                    <td class="link-table__cell"><a href="https://discord.gg/KwfCk7r">Support Server</a></td>
                  </tr>
                </table>
              </div>
              <div class="table-section__table-wrapper">
                <h4 class="table-section__table-header">Other Guides</h4>
                <table class="link-table">
                  <tr class="link-table__row">
                    <td class="link-table__cell">
                      <a href="https://owobot.fandom.com/wiki/OwO_Bot_Wiki">OwO Bot Wiki</a>
                    </td>
                  </tr>
                  <tr class="link-table__row">
                    <td class="link-table__cell">
                      <a
                        href="https://discord.gg/gg-obbe-owo-bot-battle-enthusiasts-748179924749123662"
                        >Kane's OBBE Guide</a
                      >
                    </td>
                  </tr>
                </table>
              </div>
            </div>
          </div>
        </section>
      </div>
      <Blinkies />
    </div>
  </body>
</html>
