---
const images = import.meta.glob(
  "@/assets/images/construction/*.gif",
  { eager: true, import: "default" }
);
const imageList = Object.values(images);
---
<style>
  h3 {
    text-align: center; 
    font-size: 18px; 
    font-weight: bold; 
    margin-top: 10px;
  }
  div {
    padding: 2rem;
    margin: 2rem 10rem;
    border: 1px solid gray;
  }
  img {
    height: 150px;
    display: block;
    margin: 0 auto;
  }
</style>
<script  define:vars={{imageList}}>
  const image = imageList[Math.floor(Math.random() * imageList.length)];
  const imgEL = document.querySelector<HTMLImageElement>("#construction-gif");
  if (imgEL) imgEL.src = image;
</script>

<div>
  <img id="construction-gif"/>
  <slot />
</div>