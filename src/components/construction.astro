---
const images: Record<string, imageObj> = import.meta.glob(
  "/src/assets/images/construction/*.gif",
  { eager: true, import: "default" }
);

type imageObj = {
  src: string;
  width: number;
  height: number;
  format: string;
}

const imageList = Object.values(images);
const srcList = imageList.map((image) => image.src)
---
<style>
  h3 {
    text-align: center; 
    font-size: 18px; 
    font-weight: bold; 
    margin-top: 10px;
  }
  div {
    padding: 2rem;
    margin: 2rem 10rem;
    border: 1px solid gray;
  }
  img {
    height: 150px;
    display: block;
    margin: 0 auto;
  }
</style>
<div>
  <img id="construction-gif"/>
  <slot />
</div>
<script  define:vars={{srcList}}>
  const src = srcList[Math.floor(Math.random() * srcList.length)];
  const imgEl = document.querySelector("#construction-gif");
  if (imgEl) imgEl.src = src;
</script>