---
import buffs from '@/src/data/weapon/buffs.json'

type _BaseWeapon = {
	name: string,
	aliases: string[],
	slug: string,
	wikiStars: { name: string, stars: number }[]
}

type QuasiWeapon = _BaseWeapon & {
	objectType: "quasiweapon"
}

type Weapon = _BaseWeapon & {
	objectType: "weapon"
	id: number
	statConfig: Stat[],
	wpStatConfig?: Stat,
	buffSlugs: string[],
	description: string,
	normalPassiveAmount: number
}

type Stat = {
	min: number,
	max: number,
	emoji: string[],
	unit: string,
	digits: number
}

type Buff = {
	name: string,
	description: string,
	slug: string,
	statConfig: Stat[],
	traits: { slug: string, value?: number }[]
}

const { weapon } = Astro.props as { weapon: Weapon | QuasiWeapon }

const customStatTexts: Record<string, string> = {
	'orb': 'none,<br> but two passives!',
	'fists': 'none,<br> not actually a weapon!',
}

const aliases = weapon.aliases?.length ? `aliases: ${weapon.aliases.join(', ')}` : ''

let displayStats: Stat[] = [];

if (weapon.objectType === "weapon"){
	const buffStats = weapon.buffSlugs
        .map(slug => buffs.find(buff => buff.slug === slug))
        .flatMap(buff => buff?.statConfig ?? []);	
	displayStats.push(...weapon.statConfig)
	displayStats.push(...buffStats)
	if (weapon.wpStatConfig !== undefined)
		displayStats.push(weapon.wpStatConfig)
} 

const emojiPath = (emoji: string) => `/src/assets/images/owo_images/battleEmojis/${emoji}`
---

<div class="wikipedia-container">
	<div class="wikipedia-header">
		{weapon.name}
		<div class="wikipedia-aliases">{aliases}</div>
	</div>
	<img class="wikipedia-image" src={emojiPath(`${weapon.slug}.png`)} alt={weapon.name} />
	<div class="wikipedia-stars">
		{weapon.wikiStars.map((statistic) => <div><span>{statistic.name}</span>{'★'.repeat(statistic.stars)}{'☆'.repeat(5 - statistic.stars)}</div>)}
	</div>
	<div class="wikipedia-id"><div>ID: {'id' in weapon ? weapon.id : '???'}</div></div>
	<div class="wikipedia-stats-header">Stats</div>
	{
		customStatTexts[weapon.slug]  ? (
			<div class="wikipedia-nostat" set:html={customStatTexts[weapon.slug]} />
		) : (
			<div class="wikipedia-table">
				<div>
					{['common.png', 'fabled.gif'].map((rank) => (
						<div class="wikipedia-stat-header">
							<img src={`/src/assets/images/owo_images/tiers/${rank}`} alt="" />
							{rank === 'common.png' ? '0%' : '100%'}
						</div>
					))}
				</div>
				{displayStats.map((stat) => (
					<div class="wikipedia-stat-row">
						{[stat.min, stat.max].map((extreme) => (
							<div>
								{extreme + stat.unit}
								{stat.emoji.map((emoji) => <img src={emojiPath(emoji)} title={emoji} alt={emoji} />)}
							</div>
						))}
					</div>
				))}
			</div>
		)
	}
	<div class="wikipedia-calc-link">
		{weapon.objectType === 'weapon' && <a href={`/weapon/calculator/#${weapon.slug}`}>Calculator</a>}
	</div>
</div>
